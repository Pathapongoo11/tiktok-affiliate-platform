# Database
DB_USER=tiktok
DB_PASSWORD=tiktok_secret
DB_NAME=tiktok_affiliate

# Redis
REDIS_URL=localhost:6379

# JWT
JWT_SECRET=change_this_in_production

# TikTok API (fill after TikTok Developer App is created)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/tiktok/callback

# Hugging Face — enables AI video styles (ai_video, ai_cartoon, ai_talking)
# Get a free token at https://huggingface.co/settings/tokens (role: read)
# Leave empty to disable AI styles (they fall back to ken_burns).
HUGGINGFACE_TOKEN=

# Lip-sync microservice (SadTalker on the GPU host) — enables the ai_talking style.
# Run services/lipsync/run.ps1 on the Windows host, then set:
#   LIPSYNC_URL=http://host.docker.internal:8001
# Leave empty to disable lip-sync (ai_talking falls back to ai_cartoon).
LIPSYNC_URL=

# Server
PORT=8080
ENV=development
